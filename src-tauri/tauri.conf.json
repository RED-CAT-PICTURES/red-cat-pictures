{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RED CAT PICTURES",
  "version": "../package.json",
  "identifier": "com.redcatpictures.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "dotenvx run -f .env.native -- nuxt dev",
    "beforeBuildCommand": "dotenvx run -f .env.native -- nuxt generate"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": true,
        "url": "/",
        "title": "RED CAT PICTURES",
        "width": 1400,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNDREQjdENzkyQTA2QzYKUldUR0JpcDVmZHRFTUJhYkV4TWJWMmd1ZCtpQVB3RnFsZ3o3ODRtdmtVR1NITTNkT08zRUtyL2QK",
      "endpoints": [
        "https://github.com/RED-CAT-PICTURES/red-cat-pictures/releases/latest/download/latest.json"
      ]
    }
  }
}